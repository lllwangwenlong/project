.todo-page{
  padding: 20rpx;
}
.todo-form{
  background:#fff;
  padding: 20rpx;
  border-radius: 8rpx;
}
.form-title{
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}
.todo-input{
  border:1rpx solid #eee;
  padding: 10rpx 20rpx;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
}
.todo-textarea{
  border:1rpx solid #eee;
  padding: 10rpx 20rpx;
  border-radius: 8rpx;
  height: 160rpx;
  margin-bottom: 20rpx;
  width: auto;
}
.todo-add{
  margin-top: 20rpx;
}
.todo-list{
  margin-top: 30rpx;
}
.todo-item{
  background:#fff;
  border-radius: 8rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}
.todo-name{
  font-size: 30rpx;
  font-weight: bold;
}
.todo-desc{
  font-size: 26rpx;
  color:#666;
  margin-top: 10rpx;
}
.todo-empty{
  text-align: center;
  color:#999;
  margin-top: 60rpx;
}